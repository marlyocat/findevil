# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.venv/
venv/

# Evidence data (never commit forensic images)
evidence/
*.dd
*.raw
*.E01
*.vmem
*.lime

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs — runtime trail (keep structure + docs, not captured content).
# Committed example trails live in docs/example-reports/ instead.
logs/*
!logs/.gitkeep
!logs/README.md

# Environment
.env
.env.local

# Claude Code local settings (per-user, not shared)
.claude/settings.local.json

# Agent-generated IR reports — outputs, not inputs. Curated examples live
# in docs/example-reports/ instead.
reports/
!reports/.gitkeep
IR-REPORT-*.md
